---
source: crates/podbox/tests/codegen_env.rs
expression: q
---
[Quadlet]
DefaultDependencies=false

[Unit]
Description=podbox -- myenv
Requires=myenv.socket
After=myenv.socket
Requires=myenv-proxy.service
After=myenv-proxy.service
Requires=myenv-compositor.service
After=myenv-compositor.service
StartLimitBurst=5
StartLimitIntervalSec=30s

[Container]
Image=localhost/podbox-myenv:latest
ContainerName=myenv
UserNS=nomap
User=root
SecurityLabelDisable=true
NoNewPrivileges=true
PodmanArgs=--cpus=4
ReadOnly=true
Mount=type=tmpfs,destination=/run,tmpfs-mode=1777
Mount=type=tmpfs,destination=/tmp,tmpfs-mode=1777
Mount=type=tmpfs,destination=/var/tmp,tmpfs-mode=1777
Environment=HOME=/home/%u
Environment=HOST_USER=testuser
Environment=HOST_UID=%U
Environment=HOST_GID=%G
Environment=PATH=/run/podbox/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

Network=host

Volume=/home/bet/containers/myenv:/home/%u:Z

Volume=/home/user/Documents:/home/%u/Documents:ro,z
Volume=/home/user/Downloads:/home/%u/Downloads:ro,z

Timezone=local

Environment=XDG_RUNTIME_DIR=%t
Environment=WAYLAND_DISPLAY=wayland-0
Environment=MOZ_ENABLE_WAYLAND=1
Volume=%t/podbox/myenv-wayland.sock:%t/wayland-0:ro

Volume=%t/pipewire-0:%t/pipewire-0
Environment=PIPEWIRE_RUNTIME_DIR=%t
Volume=%t/pulse:%t/pulse
Environment=PULSE_SERVER=unix:%t/pulse/native

Volume=/home/bet/.local/share/podbox/myenv/.flatpak-info:/.flatpak-info:ro

Volume=%t/podbox/myenv-dbus.sock:/run/podbox/dbus.sock:ro
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/podbox/dbus.sock

Volume=%t/podbox/myenv.sock:%t/podbox/myenv.sock

Volume=~/Work:/home/user/Work:z

Environment=EDITOR=nvim
Environment=SHELL=/usr/bin/fish
Environment=TERM=xterm-256color
Environment=PODBOX_CONTAINER=myenv

RunInit=true
WorkingDir=/home/%u
AddCapability=DAC_READ_SEARCH
AddCapability=PERFMON

[Service]
Slice=podbox.slice
CPUWeight=200
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
