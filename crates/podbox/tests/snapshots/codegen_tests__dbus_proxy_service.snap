---
source: crates/podbox/tests/codegen_tests.rs
expression: unit
---
[Unit]
Description=D-Bus Proxy for podbox container myenv
PartOf=myenv.service

[Service]
Type=simple
ExecStart=/usr/bin/xdg-dbus-proxy unix:path=%t/bus %t/podbox/myenv-dbus.sock --filter --talk=org.freedesktop.Notifications --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.Notification.*@/org/freedesktop/portal/desktop --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.OpenURI.*@/org/freedesktop/portal/desktop --call=org.freedesktop.portal.Desktop=org.freedesktop.portal.Request.*@/org/freedesktop/portal/desktop/request/* --broadcast=org.freedesktop.portal.Desktop=org.freedesktop.portal.Request.*@/org/freedesktop/portal/desktop/request/* --call=org.freedesktop.portal.Desktop=org.freedesktop.DBus.Introspectable.*@/org/freedesktop/portal/* --own=org.mpris.MediaPlayer2.podbox_app
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=myenv.service
