{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Bun's globals (Bun.*, import.meta.dir). Without this, TS auto-includes
    // every @types package but never the `bun` one under TS7, and scripts/
    // fail to typecheck. Everything else resolves through explicit imports.
    "types": ["bun"]
  }
}
