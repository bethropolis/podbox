---
import '../styles/global.css';
import { SEO } from 'astro-seo';
import { Topbar } from '../design/islands/Topbar';
import { CommandPalette } from '../design/components/CommandPalette';
import { VERSION } from '../landing/data';

interface Props {
  title: string;
  description: string;
  currentPath: string;
  isDocsPage?: boolean;
}

const { title, description, currentPath, isDocsPage = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteOrigin = 'https://bethropolis.github.io/podbox';
const canonical = `${siteOrigin}${currentPath === '/' ? '/' : currentPath + '/'}`;
// Social scrapers require absolute image URLs.
const ogImage = `${siteOrigin}/og-image.png`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'podbox',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  url: canonical,
  downloadUrl: `${siteOrigin}/install.sh`,
  codeRepository: 'https://github.com/bethropolis/podbox',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0' },
  author: { '@type': 'Person', name: 'Bethuel Kipsang' },
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: ogImage,
          url: canonical,
        },
        optional: {
          siteName: 'podbox',
          description,
          locale: 'en_US',
        },
        image: {
          alt: `${title} — podbox`,
          width: 1200,
          height: 600,
          type: 'image/png',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: ogImage,
        imageAlt: `${title} — podbox`,
      }}
      extend={{
        link: [
          { rel: 'icon', type: 'image/svg+xml', href: `${base}/favicon.svg` },
          { rel: 'icon', href: `${base}/favicon.ico`, sizes: 'any' },
          { rel: 'apple-touch-icon', href: `${base}/podbox-logo.png` },
        ],
        meta: [
          { name: 'author', content: 'Bethuel Kipsang' },
          {
            name: 'keywords',
            content:
              'podbox, podman, quadlet, systemd, rootless containers, distrobox, linux, toml, declarative containers, rust',
          },
          { name: 'robots', content: 'index, follow' },
          { name: 'theme-color', content: '#1e1e2e' },
          { name: 'generator', content: Astro.generator },
        ],
      }}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Pre-paint theme: SSR always renders mocha; reconcile before first paint.
      try {
        if (localStorage.getItem('podbox-theme') === 'latte') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      } catch {}
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[999999] focus:px-4 focus:py-2 focus:bg-[var(--accent-mauve)] focus:text-[#11111b] focus:font-bold focus:rounded-[3px] focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-white"
    >
      Skip to main content
    </a>
    <div class="min-h-screen bg-[var(--bg-base)] text-[var(--text-primary)] flex flex-col font-mono selection:bg-[var(--accent-mauve)]/25 selection:text-[var(--accent-mauve)]">
      <Topbar client:load currentPath={currentPath} isDocsPage={isDocsPage} version={VERSION} />
      <CommandPalette client:idle version={VERSION} />
      <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
        <slot />
      </main>
    </div>
    <script is:inline>
      // Delegated copy for every TerminalCodeBlock (static or island-rendered).
      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-copy-btn]');
        if (!btn) return;
        const code = btn.getAttribute('data-code') || '';
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = code;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        const label = btn.querySelector('[data-copy-label]');
        if (label) {
          const prev = label.textContent;
          label.textContent = 'copied!';
          label.classList.add('text-[var(--accent-green)]');
          setTimeout(() => {
            label.textContent = prev;
            label.classList.remove('text-[var(--accent-green)]');
          }, 2000);
        }
      });
    </script>
  </body>
</html>
