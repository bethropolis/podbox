---
import { features } from './data';
import SectionHeader from './SectionHeader.astro';
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20 lg:py-24 border-t border-[var(--border)]">
  <SectionHeader
    title="A container you can rebuild from a file"
    lede="Your home directory stays out of it unless you ask. Everything the container can reach is written down first."
  />

  {/* Plain columns, not icon cards: each item ends in the line of config or
      command that makes it true, so the claim is checkable on the spot. */}
  <div class="grid gap-x-10 gap-y-9 sm:gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <div class="border-t border-[var(--border)] pt-5">
        <h3 class="text-[15px] font-medium text-[var(--text-primary)]">{f.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-subtext)]">{f.body}</p>
        <code class="mt-4 block truncate font-mono text-xs text-[var(--text-muted)]" title={f.detail}>
          {f.detail}
        </code>
      </div>
    ))}
  </div>
</section>
