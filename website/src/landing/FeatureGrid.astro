---
import { features } from './data';
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-b border-[var(--border)]">
  <div class="mb-10">
    <div class="text-xs text-[var(--accent-mauve)] uppercase tracking-wider font-bold mb-2">
      core // philosophy
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
      Think Distrobox, but reproducible from git.
    </h2>
    <p class="mt-3 text-sm sm:text-base text-[var(--text-subtext)] leading-relaxed max-w-3xl">
      Each environment is one TOML file: base image, packages, mounts, and runtime switches.
      `podbox build` turns that into an OCI image and matching systemd Quadlet units — nothing hand-edited.
      The container gets its own isolated home directory by default. Extra folders, GPU, and Wayland sockets are strictly opt-in.
    </p>
  </div>

  {/* Feature Grid */}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {features.map((f) => (
      <div class={`p-4 rounded-[3px] border border-[var(--border)] bg-[var(--bg-mantle)] ${f.hover} transition-colors`}>
        <div class={`w-8 h-8 rounded-[2px] bg-[var(--bg-surface0)] border border-[var(--border)] flex items-center justify-center ${f.color} mb-3`}>
          <f.icon className="w-4 h-4" />
        </div>
        <h3 class="text-sm font-bold text-[var(--text-primary)] mb-1.5">
          {f.title}
        </h3>
        <p class="text-xs text-[var(--text-subtext)] leading-relaxed">
          {f.body}
        </p>
      </div>
    ))}
  </div>
</section>
