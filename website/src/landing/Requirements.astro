---
import { TerminalCodeBlock } from '../design/components/TerminalCodeBlock';

const base = import.meta.env.BASE_URL;
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-b border-[var(--border)]">
  <div class="mb-8">
    <div class="text-xs text-[var(--accent-green)] uppercase tracking-wider font-bold mb-2">
      requirements
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
      Before you start
    </h2>
  </div>

  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
  <div>
    <h3 class="text-sm font-medium text-[var(--text-primary)]">
      What you&apos;ll need
    </h3>
    <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-[var(--text-subtext)]">
      <li class="flex gap-3">
        <span class="shrink-0 text-[var(--accent-green)]">✓</span><span>Podman 5.5 or newer
        (5.6+ for SSH agent passthrough)</span>
      </li>
      <li class="flex gap-3">
        <span class="shrink-0 text-[var(--accent-green)]">✓</span><span>A systemd user session</span>
      </li>
      <li class="flex gap-3">
        <span class="shrink-0 text-[var(--accent-green)]">✓</span><span>Linux with a Wayland
        compositor (X11 apps work via Xwayland)</span>
      </li>
      <li class="flex gap-3">
        <span class="shrink-0 text-[var(--accent-peach)]">optional</span>
        <span><code class="text-[var(--accent-peach)]">xdg-dbus-proxy</code>, for filtered D-Bus access</span>
      </li>
    </ul>
  </div>

  <div>
    <h3 class="text-sm font-medium text-[var(--text-primary)]">
      Something not working?
    </h3>
    <p class="mt-4 text-sm leading-relaxed text-[var(--text-subtext)]">
      Run <code class="text-[var(--accent-peach)]">podbox doctor</code> first. It catches most setup
      problems on its own, and the{" "}
      <a href={`${base}/docs/troubleshooting/`} class="text-[var(--accent-mauve)] underline cursor-pointer">
        troubleshooting guide
      </a>{" "}
      goes deeper.
    </p>
    <div class="mt-4">
      <TerminalCodeBlock code={`podbox doctor`} language="bash" />
    </div>
  </div>
  </div>
</section>
