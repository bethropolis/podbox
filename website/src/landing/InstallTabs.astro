---
import { TerminalCodeBlock } from '../design/components/TerminalCodeBlock';
import { ChevronRight } from 'lucide-react';
import { installTabs, installCommands, firstRunCommand, cargoNote } from './data';

const base = import.meta.env.BASE_URL;
---

{/* Install method tabs + code blocks (CSS-only tabs, zero JS).
    No outer terminal window: each TerminalCodeBlock brings its own
    chrome, so the tabs and footer render as plain rows. */}
<div class="install-tabs">
  {/* Install tabs */}
  <div role="tablist" aria-label="Installation options" class="flex flex-wrap items-center gap-1.5 mb-3 text-[11px]">
    {installTabs.map((tab, i) => (
      <>
        <input type="radio" name="install-tab" id={`install-tab-${tab.id}`} checked={i === 0} />
        <label
          for={`install-tab-${tab.id}`}
          role="tab"
          class={`install-tab-label px-2.5 py-1 rounded-[2px] border border-[var(--border)] transition-colors cursor-pointer whitespace-nowrap`}
        >
          {tab.label}
        </label>
      </>
    ))}
  </div>

  {/* Code panels: install method only */}
  {installTabs.map((tab) => (
    <div id={`install-panel-${tab.id}`} role="tabpanel" class="install-panel">
      <TerminalCodeBlock code={installCommands[tab.id]} language="bash" showLineNumbers />
      {tab.id === 'cargo' && (
        <p class="py-2 text-[11px] leading-relaxed text-[var(--text-muted)]">{cargoNote}</p>
      )}
    </div>
  ))}

  {/* First run: shared, always visible */}
  <div class="mt-3">
    <TerminalCodeBlock code={firstRunCommand} language="bash" filename="first run" showLineNumbers />
  </div>

  <div class="mt-3 text-[11px] text-[var(--text-muted)] flex flex-wrap items-center justify-between gap-2">
    <span>* That&apos;s a prebuilt environment with no config file needed</span>
    <a
      href={`${base}/docs/getting-started/`}
      class="text-[var(--accent-blue)] hover:underline flex items-center gap-1 cursor-pointer"
    >
      <span>Read the Getting Started guide</span>
      <ChevronRight className="w-3 h-3" />
    </a>
  </div>
</div>
