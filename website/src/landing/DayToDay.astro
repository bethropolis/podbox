---
import { TerminalCodeBlock } from '../design/components/TerminalCodeBlock';
import { dayToDay } from './data';
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-b border-[var(--border)]">
  <div class="mb-8">
    <div class="text-xs text-[var(--accent-peach)] uppercase tracking-wider font-bold mb-2">
      every day
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
      The commands you will actually use
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {dayToDay.map((block) => (
      <div>
        <h3 class="text-sm font-medium text-[var(--text-primary)] mb-2.5">{block.title}</h3>
        {/* Bare: the heading above labels the block, so a title bar with
            traffic lights and a language name would only repeat it. */}
        <div class="rounded-[3px] border border-[var(--border)]">
          <TerminalCodeBlock code={block.code} language="bash" bare />
        </div>
      </div>
    ))}
  </div>
</section>