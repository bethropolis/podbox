---
import { TerminalCodeBlock } from '../design/components/TerminalCodeBlock';
import { dayToDay } from './data';
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-b border-[var(--border)]">
  <div class="mb-8">
    <div class="text-xs text-[var(--accent-peach)] uppercase tracking-wider font-bold mb-2">
      workflow // daily-ops
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
      Day-to-day command examples
    </h2>
    <p class="mt-3 text-sm text-[var(--text-subtext)] max-w-3xl leading-relaxed">
      Once built, podbox gives you natural, fast commands to enter, run commands, export apps, or inspect your containers.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {dayToDay.map((block) => (
      <div>
        <div class="text-xs font-bold text-[var(--text-subtext)] mb-2 flex items-center gap-2">
          <span class={`w-2 h-2 rounded-full ${block.dot}`}></span>
          {block.title}
        </div>
        <TerminalCodeBlock code={block.code} language="bash" />
      </div>
    ))}
  </div>
</section>
