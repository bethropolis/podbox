---
import { GithubIcon } from '../design/components/GithubIcon';
import { ArrowRight } from 'lucide-react';
import InstallTabs from './InstallTabs.astro';
import { VERSION } from './data';

const base = import.meta.env.BASE_URL;

// CI status is resolved once at build time and baked into the static HTML.
// Only COMPLETED runs are considered: this page is deployed by the very
// push that triggers CI, so the newest run is always the one still in
// flight and would report "running" forever. Falls back to "passing" if
// the request fails (rate limit, offline).
let ciStatus = 'passing';
let ciColor = 'var(--accent-green)';
try {
  const res = await fetch(
    'https://api.github.com/repos/bethropolis/podbox/actions/workflows/ci.yml/runs?per_page=10',
    {
      signal: AbortSignal.timeout(5000),
      headers: {
        Accept: 'application/vnd.github+json',
        ...(import.meta.env.GITHUB_TOKEN
          ? { Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}` }
          : {}),
      },
    },
  );
  if (res.ok) {
    const runs = ((await res.json()) as any)?.workflow_runs ?? [];
    const last = runs.find((r: any) => r?.status === 'completed');
    if (!last) {
      ciStatus = 'no runs yet';
      ciColor = 'var(--text-muted)';
    } else if (last.conclusion === 'success') {
      ciStatus = 'passing';
      ciColor = 'var(--accent-green)';
    } else {
      ciStatus = last.conclusion === 'cancelled' ? 'cancelled' : 'failing';
      ciColor = last.conclusion === 'cancelled' ? 'var(--text-muted)' : 'var(--accent-red)';
    }
  }
} catch {
  // keep fallback
}
---

<section class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-12 sm:pt-18 pb-16">
  {/* Real Tagline with Blinking Cursor */}
  <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.15] mb-6">
    Define once. Run anywhere.
    <br />
    <span class="text-[var(--accent-mauve)]">No host daemon</span><span class="cursor-blink text-[var(--accent-blue)] ml-1 font-normal">_</span>
  </h1>

  {/* Authentic Description */}
  <p class="text-base sm:text-lg text-[var(--text-subtext)] leading-relaxed max-w-3xl mb-6">
    You write a TOML file. podbox turns it into an image and a set of systemd units, and from
    then on systemd does the rest. Nothing of podbox keeps running on your machine.
  </p>

  {/* Facts */}
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-10 select-none text-xs">
    <span class="text-[var(--text-muted)]">
      Version <span class="text-[var(--accent-blue)] font-bold ml-1">v{VERSION}</span>
    </span>
    <a
      href="https://github.com/bethropolis/podbox/actions/workflows/ci.yml"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
    >
      CI <span class="font-bold ml-1" style={`color: ${ciColor}`}>{ciStatus}</span>
    </a>
    <span class="text-[var(--text-muted)]">
      License <span class="text-[var(--accent-mauve)] font-bold ml-1">MIT</span>
    </span>
    <span class="text-[var(--text-muted)]">
      Platform <span class="text-[var(--accent-peach)] font-bold ml-1">Linux, rootless</span>
    </span>
  </div>

  {/* CTAs */}
  <div class="flex flex-wrap items-center gap-3 mb-12">
    <a
      href={`${base}/docs/getting-started/`}
      class="flex items-center gap-2 px-5 py-2.5 rounded-[2px] bg-[var(--accent-mauve)] text-[#11111b] font-bold text-xs sm:text-sm hover:brightness-110 transition-all cursor-pointer shadow-xs"
    >
      <span>Get Started</span>
      <ArrowRight className="w-4 h-4" />
    </a>

    <a
      href={`${base}/docs/`}
      class="flex items-center gap-2 px-5 py-2.5 rounded-[2px] bg-[var(--bg-mantle)] hover:bg-[var(--bg-surface0)] border border-[var(--border)] text-xs sm:text-sm font-semibold text-[var(--text-primary)] transition-colors cursor-pointer"
    >
      <span>Read Documentation</span>
    </a>

    <a
      href="https://github.com/bethropolis/podbox"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2.5 rounded-[2px] bg-[var(--bg-mantle)] hover:bg-[var(--bg-surface0)] border border-[var(--border)] text-xs sm:text-sm text-[var(--text-subtext)] hover:text-[var(--text-primary)] transition-colors"
    >
      <GithubIcon className="w-4 h-4" />
      <span>GitHub</span>
    </a>
  </div>

  <InstallTabs />
</section>
