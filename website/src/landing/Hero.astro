---
import { GithubIcon } from '../design/components/GithubIcon';
import { ArrowRight } from 'lucide-react';
import BuildPreview from './BuildPreview.astro';
import { VERSION } from './data';

const base = import.meta.env.BASE_URL;

// CI status is resolved once at build time and baked into the static HTML.
// Only COMPLETED runs are considered: this page is deployed by the very
// push that triggers CI, so the newest run is always the one still in
// flight and would report "running" forever. Falls back to "passing" if
// the request fails (rate limit, offline).
let ciStatus = 'passing';
let ciColor = 'var(--accent-green)';
try {
  const res = await fetch(
    'https://api.github.com/repos/bethropolis/podbox/actions/workflows/ci.yml/runs?per_page=10',
    {
      signal: AbortSignal.timeout(5000),
      headers: {
        Accept: 'application/vnd.github+json',
        ...(import.meta.env.GITHUB_TOKEN
          ? { Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}` }
          : {}),
      },
    },
  );
  if (res.ok) {
    const runs = ((await res.json()) as any)?.workflow_runs ?? [];
    const last = runs.find((r: any) => r?.status === 'completed');
    if (!last) {
      ciStatus = 'no runs yet';
      ciColor = 'var(--text-muted)';
    } else if (last.conclusion === 'success') {
      ciStatus = 'passing';
      ciColor = 'var(--accent-green)';
    } else {
      ciStatus = last.conclusion === 'cancelled' ? 'cancelled' : 'failing';
      ciColor = last.conclusion === 'cancelled' ? 'var(--text-muted)' : 'var(--accent-red)';
    }
  }
} catch {
  // keep fallback
}
---

<section class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-12 sm:pt-20 lg:pt-24 pb-14 sm:pb-20 lg:pb-24 grid grid-cols-[minmax(0,1fr)] gap-12 lg:gap-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-center">
  <div>
    <h1 class="text-[clamp(2.35rem,10.5vw,3.75rem)] font-semibold tracking-[-0.032em] leading-[1.04] text-[var(--text-primary)]">
      Define once.<br />
      Run anywhere.<br />
      <span class="text-[var(--accent-mauve)]">No host daemon.</span>
    </h1>

    <p class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-[var(--text-subtext)]">
      Write one TOML file. podbox turns it into a container image and a few systemd units,
      then gets out of the way. Nothing of podbox keeps running on your machine.
    </p>

    <div class="mt-8 flex items-center gap-3">
      <a
        href={`${base}/docs/getting-started/`}
        class="inline-flex flex-1 sm:flex-none justify-center items-center gap-2 rounded-md bg-[var(--accent-mauve)] px-4 py-2.5 text-sm font-semibold text-[var(--bg-crust)] transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-mauve)]"
      >
        Get started
        <ArrowRight className="w-4 h-4" />
      </a>
      <a
        href={`${base}/docs/`}
        class="inline-flex flex-1 sm:flex-none justify-center items-center rounded-md border border-[var(--border)] px-4 py-2.5 text-sm font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--border-focus)] hover:bg-[var(--bg-mantle)]"
      >
        Documentation
      </a>
      <a
        href="https://github.com/bethropolis/podbox"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 rounded-md px-3 py-2.5 text-sm text-[var(--text-subtext)] transition-colors hover:text-[var(--text-primary)]"
      >
        <GithubIcon className="w-4 h-4" />
        GitHub
      </a>
    </div>

    <ul class="mt-8 sm:mt-10 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-xs text-[var(--text-muted)]">
      <li>v{VERSION}</li>
      <li aria-hidden="true" class="hidden sm:block">·</li>
      <li>
        <a
          href="https://github.com/bethropolis/podbox/actions/workflows/ci.yml"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-[var(--text-primary)] transition-colors"
        >
          <span class="inline-block h-1.5 w-1.5 rounded-full" style={`background: ${ciColor}`} aria-hidden="true"></span>
          CI {ciStatus}
        </a>
      </li>
      <li aria-hidden="true" class="hidden sm:block">·</li>
      <li>MIT</li>
      <li aria-hidden="true" class="hidden sm:block">·</li>
      <li>Linux, rootless Podman</li>
    </ul>
  </div>

  <BuildPreview />
</section>
